{
  "name": "quickytrade",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "desktop:dev": "PATH=\"$HOME/.cargo/bin:$PATH\" tauri dev",
    "desktop:package:mac": "PATH=\"$HOME/.cargo/bin:$PATH\" tauri build",
    "test": "node --test && npm run test:core",
    "test:alert": "bash scripts/send_test_alert.sh",
    "test:core": "PYTHONPATH=core python3 -m unittest discover -s core/tests -v",
    "check": "node --check app.js && node --check server.mjs && node --check src/operator/*.js && node --check src/tradingview/*.js && python3 -m compileall -q core/quickytrade_core core/tests && npm test",
    "lint": "eslint . && npm run lint:core",
    "lint:core": "python3 -m ruff check core/quickytrade_core core/tests"
  },
  "engines": {
    "node": ">=22.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "eslint": "^10.7.0",
    "globals": "^17.7.0"
  }
}
